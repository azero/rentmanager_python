# Copy to .env and fill in your Rent Manager credentials.
RM_CORP_ID=sampleco
RM_USERNAME=api-user
RM_PASSWORD=secret
RM_LOCATION_ID=1

# Common example inputs. Set only the ones needed by the script you run.
RM_EXAMPLE_PROPERTY_ID=123
RM_EXAMPLE_OWNER_ID=456
RM_EXAMPLE_TENANT_ID=789
RM_EXAMPLE_EMAIL=tenant@example.com
RM_EXAMPLE_PHONE_NUMBER=+15551234567
RM_EXAMPLE_PARENT_TYPE=Tenant
RM_EXAMPLE_PARENT_ID=789
RM_EXAMPLE_SEARCH_NAME=Smith
RM_EXAMPLE_SEARCH_TYPE=all

# Text sending is opt-in. Leave false unless you intend to create an outgoing text.
RM_EXAMPLE_SEND_TEXT=false
RM_EXAMPLE_TEXT_MESSAGE=Hello from rentmanager_api.
